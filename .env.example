# Copy to .env and set JWT_SECRET (e.g. `openssl rand -hex 32`). Never commit .env.
ENVIRONMENT=local
USE_POSTGRESQL_DB=false
SQLITE_PATH=db/expense_sarathi.db

# PostgreSQL (only when USE_POSTGRESQL_DB=true)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expense_sarathi
DB_USER=expense
DB_PASSWORD=expense

JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_IDLE_MINUTES=30

# http://localhost is not HTTPS, so the refresh cookie must not be Secure locally.
COOKIE_SECURE=false
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ENABLE_API_DOCS=true
LOG_LEVEL=DEBUG
